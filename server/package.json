    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "@koa/router": "^14.0.0",
    "koa": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
