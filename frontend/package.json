    "@react-pdf-viewer/zoom": "^3.12.0",
    "@sentry/vue": "^10.49.0",
    "@stripe/stripe-js": "^9.2.0",
    "@tinymomentum/liquid-glass-vue": "^1.0.9",
    "axios": "^1.8.4",
    "dexie": "~4.0.11",
    "dompurify": "^3.3.3",
    "floating-vue": "^5.2.2",
    "highlight.js": "^11.11.1",
    "iso-639-1": "^3.1.5",
    "jspdf": "^4.2.1",
    "katex": "^0.16.45",
    "marked": "^18.0.0",
    "mermaid": "^11.14.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
