    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/ui": "^1.0.0",
    "@vue/test-utils": "^2.4.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^12.10.3",
    "prettier": "^3.8.3",
