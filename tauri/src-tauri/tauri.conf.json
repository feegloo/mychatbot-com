{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatRAG",
  "version": "0.1.0",
  "identifier": "chatrag.app",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev -- --host 0.0.0.0 --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "ChatRAG",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousRemoteDomainIpcAccess": [
        {
          "domain": "localhost",
          "windows": ["main"],
          "plugins": [],
          "enableTauriApi": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
