{
  "name": "chatrag-cloud-function-upload-proxy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gcp-build": "npm run build",
    "dev": "npm run build && functions-framework --target=uploadProxy --signature-type=http --source=dist",
    "start": "functions-framework --target=uploadProxy --signature-type=http --source=dist"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^4.0.0",
    "@sentry/node": "^10.49.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.8.2"
  }
}
