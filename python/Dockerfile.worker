# Worker Dockerfile — lightweight Python-only container for chatrag-worker.
#
# Used by the ``chatrag-worker`` Cloud Run Worker Pool that pulls from the
# indexing Pub/Sub subscription. Contains only the Python source + deps (no
# Node, no frontend, no backend). All heavy imports (chromadb, fitz,
# openai) are pre-compiled into .pyc so the subscriber cold-starts in
# a few seconds.
#
# Build:
#   docker build -f python/Dockerfile.worker -t chatrag-worker python/
#
# Run locally (test — needs Pub/Sub creds + DATABASE_URL):
#   docker run --rm \
#     -e PUBSUB_SUBSCRIPTION=chatrag-indexing-sub \
#     -e GCP_PROJECT_ID=my-project \
#     -e DATABASE_URL=... -e OPENAI_API_KEY=sk-... \
#     -v $HOME/.config/gcloud:/root/.config/gcloud:ro \
#     chatrag-worker
#
# Deploy:
#   ./infra/cloudrun/deploy-gcp.sh  (with DEPLOY_WORKER=true)

FROM python:3.12-slim

# System deps for PyMuPDF, psycopg2, Pillow
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (cached layer — biggest cold-start win).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Python source only — no Node / no frontend dist.
COPY src/ ./src/

# Pre-compile .pyc files for faster startup.
RUN python -m compileall -q src/

# Subscriber entry point — blocks on streaming pull.
CMD ["python", "src/worker_pubsub.py"]

