# Worker Dockerfile for Cloud Run Jobs
# Pre-caches all Python dependencies in the image for fast cold starts.
#
# Build:
#   docker build -f Dockerfile.worker -t chatrag-worker python/
#
# Run locally (test):
#   docker run -e WORKER_PDF_PATH=/data/test.pdf -e WORKER_PAGE_IDX=0 \
#     -e WORKER_TOTAL_PAGES=5 -e WORKER_CONVERSATION_ID=test \
#     -e WORKER_COLLECTION_NAME=test -e OPENAI_API_KEY=sk-... \
#     -v $(pwd)/storage:/data chatrag-worker
#
# Deploy to Cloud Run Jobs:
#   gcloud run jobs create chatrag-worker \
#     --image=REGION-docker.pkg.dev/PROJECT/chatrag/worker:latest \
#     --region=europe-west1 \
#     --set-env-vars="OPENAI_API_KEY=...,DATABASE_URL=...,CHROMA_HTTP_HOST=..."

FROM python:3.12-slim

# System deps for PyMuPDF (C extension), psycopg2, Pillow
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (cached layer — biggest time saver for cold starts)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Pre-compile .pyc files for faster startup
RUN python -m compileall -q shared/ worker.py

# Worker entry point
CMD ["python", "worker.py"]
