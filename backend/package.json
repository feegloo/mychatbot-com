{
  "name": "chatrag-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "docker:init": "cat sql/schema.sql | docker exec -i chatrag-postgres psql -U chatrag -d chatrag && cat sql/migration.sql | docker exec -i chatrag-postgres psql -U chatrag -d chatrag"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/translate": "^9.3.0",
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^14.0.0",
    "dotenv": "^16.4.7",
    "is-generator-function": "^1.1.0",
    "koa": "^3.2.0",
    "koa-bodyparser": "^4.4.1",
    "koa-send": "^5.0.1",
    "koa-static": "^5.0.0",
    "mime-types": "^2.1.35",
    "pg": "^8.14.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__multer": "^2.0.8",
    "@types/koa__router": "^12.0.5",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-send": "^4.1.6",
    "@types/koa-static": "^4.0.4",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
