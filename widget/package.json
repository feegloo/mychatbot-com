{
  "name": "chatrag-widget",
  "version": "1.0.0",
  "description": "Embed a ChatRAG.app chatbot on any website with a single line of code",
  "type": "module",
  "main": "dist/chatrag-widget.umd.cjs",
  "module": "dist/chatrag-widget.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chatrag-widget.js",
      "require": "./dist/chatrag-widget.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch"
  },
  "keywords": [
    "chatbot",
    "chatrag",
    "rag",
    "widget",
    "embed",
    "ai",
    "chat"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/chatrag-widget"
  },
  "homepage": "https://chatrag.app",
  "devDependencies": {
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
