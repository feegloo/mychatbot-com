# ──────────────────────────────────────────────────────────────────────────────
# ChatRAG prod environment - Option A now, future chatrag.app migration later
# New project initially uses GCP generated URLs. When old project is detached,
# you can map chatrag.app to SERVER_SERVICE_NAME without changing app code.
# Run with: ENV=prod ./infra/deploy-gcp.sh
# ──────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=prod
GCP_PROJECT_ID=chatrag-app
GCP_REGION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=

# Future public domain. Used in CORS and docs now, domain mapping later.
PUBLIC_APP_DOMAIN=https://chatrag.app
ALLOWED_ORIGINS=https://chatrag.app

SERVICE_PREFIX=chatrag
SERVER_SERVICE_NAME=chatrag-server
UPLOAD_FUNCTION_NAME=chatrag-upload
WORKER_POOL_NAME=chatrag-worker
ARTIFACT_REPOSITORY=chatrag

# Production starts with one warm SSE server; set max=1 while /ask correlation is in-memory.
SERVER_CPU=0.5
SERVER_MEMORY=1Gi
SERVER_MIN_INSTANCES=0
SERVER_MAX_INSTANCES=1

# Worker Pool is manually sized. 1 keeps it warm; 0 pauses it completely.
WORKER_CPU=0.5
WORKER_MEMORY=1Gi
WORKER_INSTANCES=1
WORKER_STATUS=processing
ASK_TIMEOUT_MS=20000

GCS_BUCKET=chatrag-app-storage
PUBSUB_TOPIC=chatrag-worker-topic
PUBSUB_SUBSCRIPTION=chatrag-worker-sub
PUBSUB_ANSWER_TOPIC=chatrag-answer-topic
PUBSUB_ANSWER_SUBSCRIPTION=chatrag-answer-sub

DB_INSTANCE_NAME=chatrag-db
DB_NAME=chatrag
DB_USER=chatrag
DB_PASSWORD=

# Leave empty on first deploy: deploy-gcp.sh derives GCP internal URLs.
# After custom domain migration, set VITE_APP_BASE_URL=https://chatrag.app.
VITE_APP_BASE_URL=
VITE_UPLOAD_FUNCTION_URL=
VITE_SENTRY_DSN=https://8ab6021e8ddad8940195b30abaf721ed@o4507817217490944.ingest.de.sentry.io/4511240107917392
VITE_SENTRY_ENVIRONMENT=production

SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=chatrag@1.0.0
SENTRY_ORG=minimal-mc
SENTRY_AUTH_TOKEN=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
SENTRY_FRONTEND_PROJECT=chatrag-frontend
SENTRY_SERVER_PROJECT=chatrag-backend
SENTRY_WORKER_PROJECT=chatrag-python
SENTRY_CLOUD_FUNCTION_PROJECT=chatrag-backend
SENTRY_SERVER_DSN=https://3e80fbbfcdc532bc59906ac914a2e9c4@o4507817217490944.ingest.de.sentry.io/4511240126791760
SENTRY_WORKER_DSN=https://3f5bebc73f5b6aae5c3b7c5bdebd82dc@o4507817217490944.ingest.de.sentry.io/4511240136491088
SENTRY_CLOUD_FUNCTION_DSN=https://3e80fbbfcdc532bc59906ac914a2e9c4@o4507817217490944.ingest.de.sentry.io/4511240126791760
