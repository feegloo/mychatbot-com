# Copy to infra/.env.dev.local for local dev deploy secrets.
# This file is ignored by git.

# Required after the first deploy when the Cloud SQL instance already exists.
DB_PASSWORD=

# Optional Sentry DSNs for tracing.
VITE_SENTRY_DSN=
SENTRY_SERVER_DSN=
SENTRY_WORKER_DSN=
SENTRY_CLOUD_FUNCTION_DSN=

# Optional Sentry release automation.
SENTRY_AUTH_TOKEN=
