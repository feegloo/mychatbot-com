# ──────────────────────────────────────────────────────────────────────────────
# ChatRAG dev environment - Option A
# New project uses GCP generated URLs, not chatrag.app domain mapping yet.
# Run with: ENV=dev ./infra/deploy-gcp.sh
# ──────────────────────────────────────────────────────────────────────────────

# Environment name used in service names, Sentry environment, logs, and labels.
ENVIRONMENT=dev

# New GCP project id for this deployment.
GCP_PROJECT_ID=chatrag-app

# Main region for Cloud Run, Cloud Functions, Artifact Registry, GCS, and Cloud SQL.
GCP_REGION=europe-west1

# Absolute path to service account JSON for deploy.
# Example: /Users/olek/.gcp/chatrag-app-deployer.json
GOOGLE_APPLICATION_CREDENTIALS=

# Future production domain. In Option A it is only an allowed origin / documentation value.
# Do not map this domain until you detach it from the old project.
PUBLIC_APP_DOMAIN=https://chatrag.app

# Extra origins allowed by Cloud Function CORS, comma-separated.
# Add local Vite URL and old production domain while testing.
ALLOWED_ORIGINS=http://localhost:5173,https://chatrag.app

# Shared prefix for service/database/topic names.
SERVICE_PREFIX=chatrag

# Dev services use -dev suffix to safely coexist with prod inside the same GCP project.
SERVER_SERVICE_NAME=chatrag-dev-server
UPLOAD_FUNCTION_NAME=chatrag-dev-upload
WORKER_POOL_NAME=chatrag-dev-worker
ARTIFACT_REPOSITORY=chatrag

# Cloud Run server sizing. Keep max=1 because /ask waits in memory for answer Pub/Sub response.
SERVER_CPU=1
SERVER_MEMORY=1Gi
SERVER_MIN_INSTANCES=0
SERVER_MAX_INSTANCES=1

# Worker Pool sizing. 0 pauses worker, 1 keeps one warm worker.
WORKER_CPU=1
WORKER_MEMORY=1Gi
WORKER_INSTANCES=1

# Worker status. Set idle to consume/log Pub/Sub messages without processing.
WORKER_STATUS=processing

# Max time server /ask waits for answer from worker through Pub/Sub.
ASK_TIMEOUT_MS=20000

# GCS bucket for uploaded files. Must be globally unique.
GCS_BUCKET=chatrag-app-dev-storage

# Worker job Pub/Sub bus.
PUBSUB_TOPIC=chatrag-dev-worker-topic
PUBSUB_SUBSCRIPTION=chatrag-dev-worker-sub

# Worker answer Pub/Sub bus consumed by the Node server.
PUBSUB_ANSWER_TOPIC=chatrag-dev-answer-topic
PUBSUB_ANSWER_SUBSCRIPTION=chatrag-dev-answer-sub

# Cloud SQL PostgreSQL. Dev uses small cheap instance.
DB_INSTANCE_NAME=chatrag-dev-db
DB_NAME=chatrag_dev
DB_USER=chatrag
DB_PASSWORD=

# Frontend build-time envs. For Option A, use internal GCP URLs.
# deploy-gcp.sh can derive VITE_UPLOAD_FUNCTION_URL if empty.
VITE_APP_BASE_URL=
VITE_UPLOAD_FUNCTION_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=dev

# Sentry release/env shared by backend services.
SENTRY_ENVIRONMENT=dev
SENTRY_RELEASE=chatrag@dev

# Optional Sentry org/token placeholders for future release upload automation.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=

# Sentry project slugs for documentation.
SENTRY_FRONTEND_PROJECT=chatrag-frontend
SENTRY_SERVER_PROJECT=chatrag-server
SENTRY_WORKER_PROJECT=chatrag-worker
SENTRY_CLOUD_FUNCTION_PROJECT=chatrag-cloud-function

# Backend Sentry DSNs. Required by deploy script to avoid accidentally deploying without tracing.
SENTRY_SERVER_DSN=https://3e80fbbfcdc532bc59906ac914a2e9c4@o4507817217490944.ingest.de.sentry.io/4511240126791760
SENTRY_WORKER_DSN=https://3f5bebc73f5b6aae5c3b7c5bdebd82dc@o4507817217490944.ingest.de.sentry.io/4511240136491088
SENTRY_CLOUD_FUNCTION_DSN=https://3e80fbbfcdc532bc59906ac914a2e9c4@o4507817217490944.ingest.de.sentry.io/4511240126791760
